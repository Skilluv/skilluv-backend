# Rust
/target
*.pdb

# Local cargo config (Windows contributors copy .cargo/config.toml.windows.example)
.cargo/config.toml

# GeoNames data (downloaded at setup, ~31MB)
/data/cities*.txt
/data/countryInfo.txt

# Environment
.env
.env.*
!.env.example

# Deployment secrets (never commit)
.secrets-*

# Local docker-compose overrides (postgres bug workaround, etc.)
docker-compose.override.yml

# Trello local snapshots (regenerated via scripts/trello.py)
.trello-*.md

# BMAD workflow
_bmad/
_bmad.*
_bmad-*/
_bmad-output/

# AI coding assistant caches
.claude/
.claude.*

# `docs/` is hand-written and tracked — fourteen files were committed here
# before this rule existed, and it only ever caught the fifteenth. Ignoring a
# directory whose contents are tracked means every new document needs `-f`,
# which is how documents stop being written.
design-artifacts/

# OS
*.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.iml
*.sln
*.user
*.suo

# Logs & temp
*.log
*.tmp
*.bak
*.swp
*.swo
*.cache

# Binaries
*.exe
*.dll
*.so
*.dylib

# Archives
*.zip
*.tar.gz
*.7z

# Python (skilluv-ai)
*.pyc
*.pyo
*.egg
*.egg-info/
dist/
build/

# Generated by scripts/discord-setup.py from one specific Discord server.
# Channel snowflakes are not secrets, but they belong to one deployment and
# the script regenerates them in two seconds — committing them would be
# committing another server's addresses.
ops/discord/routing.generated.sql
