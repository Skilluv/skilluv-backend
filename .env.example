# Database
DATABASE_URL=postgres://skilluv:skilluv_secret@localhost:5433/skilluv

# Redis
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=3001

# Auth
JWT_SECRET=change-this-to-a-secure-random-string

# Enterprise B2B SSO — encryption key for at-rest IdP client_secret storage.
# 32 bytes base64. Generate with: `openssl rand -base64 32`.
# Required in production ; if omitted the SSO endpoints refuse to persist configs.
SSO_ENCRYPTION_KEY=

# URLs
# BASE_URL     — API origin. SSO redirect_uri + WebAuthn RP are derived from it.
# FRONTEND_URL — origin the user's browser is on. Every emailed link points here.
#                Defaults to BASE_URL; set it as soon as the API has its own host
#                (e.g. BASE_URL=https://api.example.com, FRONTEND_URL=https://example.com).
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
JUDGE0_URL=http://localhost:2358

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=http://localhost:9004
MINIO_ACCESS_KEY=skilluv
MINIO_SECRET_KEY=skilluv_secret
MINIO_BUCKET=avatars
# Private bucket for KYC docs + RGPD exports. Never made public.
MINIO_BUCKET_PRIVATE=documents

# CDN in front of MinIO avatars (Cloudflare, Bunny, etc.). Optional — when set,
# avatar URLs returned to the client use this base instead of the direct MinIO endpoint.
# AVATAR_CDN_BASE_URL=https://avatars.skilluv.com

# Email (Brevo)
# BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM=noreply@skilluv.com
EMAIL_FROM_NAME=Skilluv

# Brevo webhook token (set in Brevo console under Transactional > Webhooks). Required for bounce handling.
# BREVO_WEBHOOK_TOKEN=long-random-string-shared-with-brevo

# Local SMTP (Mailpit) — takes priority over BREVO_API_KEY when set.
# Web UI: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
# SMTP_USER=
# SMTP_PASSWORD=

# GitHub OAuth (Phase 2 Sprint 5)
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GITHUB_REDIRECT_URI=https://api.skilluv.com/api/auth/github/callback

# Stripe (Phase 3)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=https://skilluv.com/enterprise/credits/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://skilluv.com/enterprise/credits/canceled
# STRIPE_PORTAL_RETURN_URL=https://skilluv.com/enterprise/credits

# OAuth login providers (Phase 3.1 + 3.2)
# GITHUB_LOGIN_REDIRECT_URI=https://api.skilluv.com/api/auth/github/login/callback
# GOOGLE_CLIENT_ID=xxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
# GOOGLE_REDIRECT_URI=https://api.skilluv.com/api/auth/google/callback
# LINKEDIN_CLIENT_ID=xxxx
# LINKEDIN_CLIENT_SECRET=xxxx
# LINKEDIN_REDIRECT_URI=https://api.skilluv.com/api/auth/linkedin/callback

# Skilluv billing metadata (used in invoice HTML — Phase 3.10)
# SKILLUV_BILLING_ADDRESS="123 Rue Skilluv\n75001 Paris, France"
# SKILLUV_SIRET=000000000
# SKILLUV_VAT_NUMBER=FR00000000000

# Logging
RUST_LOG=skilluv_backend=debug,tower_http=debug

# Environment (dev | staging | prod). Used as Sentry "environment" tag.
ENVIRONMENT=dev

# Optional release identifier (defaults to crate version). Set to git SHA in CI for proper release tracking.
# RELEASE=abc1234

# Sentry / GlitchTip (self-hosted, API-compatible). Leave empty to disable error tracking.
# SENTRY_DSN=http://<key>@glitchtip.skilluv.com/1
# SENTRY_TRACES_SAMPLE_RATE=0.1

# External PDF renderer for invoice PDF export (BE-P0-36).
# Expects a service accepting POST {URL}/render with text/html body and
# returning application/pdf. Recommended : skilluv-pdf-renderer (Python +
# weasyprint) deployed as a sidecar via Coolify.
# If unset, GET /enterprise/invoices/{id}/pdf returns 503.
# PDF_RENDERER_URL=http://skilluv-pdf-renderer:8000

# PostHog product analytics (self-host preferred). Leave empty to disable.
# POSTHOG_HOST=https://posthog.skilluv.com
# POSTHOG_API_KEY=phc_xxx

# Metrics endpoint token. If set, GET /metrics requires Authorization: Bearer <token>.
# METRICS_TOKEN=long-random-string

# ─── Dev / staging helpers (JAMAIS activer en prod) ───────────────────
# SKILLUV_DEV_MODE=true active des endpoints de debug sous /api/dev/* pour
# permettre à Playwright/curl de scripter les tests e2e sans passer par un
# client email. Voir src/routes/dev.rs — actuellement /verify-tokens/{email}.
# Le backend REFUSE de booter avec ENVIRONMENT=prod si cette var est set.
# SKILLUV_DEV_MODE=true

# SKILLUV_RATELIMIT_IP_WHITELIST : IPs (comma-separated) exemptées du
# rate-limiter Redis. Utile en staging pour laisser tourner les runs
# Playwright depuis une IP dev sans se manger un 429 après ~5 tentatives.
# À ne PAS mettre d'IP publique en prod.
# SKILLUV_RATELIMIT_IP_WHITELIST=154.66.137.10,192.0.2.42

# ─── Backup (skilluv-backup binary) ──────────────────────────────
# Required when running the `skilluv-backup` CLI. Not needed for the API server.
# BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_R2_BUCKET=skilluv-backups
# BACKUP_R2_ACCESS_KEY=...
# BACKUP_R2_SECRET_KEY=...
# BACKUP_PREFIX=skilluv/postgres/
# BACKUP_TEMP_DIR=/var/tmp/skilluv-backup
# BACKUP_PG_DUMP=pg_dump
# BACKUP_PG_RESTORE=pg_restore
# BACKUP_PSQL=psql
# Optional notification webhook (Slack incoming webhook, Discord webhook, or any HTTP endpoint accepting JSON).
# BACKUP_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/T0000/B0000/XXXX
# BACKUP_NOTIFY_KIND=slack    # slack | discord | generic

# MinIO mirror (for `skilluv-backup minio-mirror`). If unset, falls back to MINIO_* above.
# BACKUP_MINIO_SOURCE_ENDPOINT=http://localhost:9004
# BACKUP_MINIO_SOURCE_BUCKET=avatars
# BACKUP_MINIO_SOURCE_ACCESS_KEY=...
# BACKUP_MINIO_SOURCE_SECRET_KEY=...
# BACKUP_MINIO_SOURCE_REGION=us-east-1
# BACKUP_MINIO_PREFIX=skilluv/minio-avatars/

# ─── BE-A + BE-C — Admin panel security ─────────────────────────
# CSV origins autorisées à consommer /api/admin/*. En prod, mettre le
# domaine admin (ex: https://admin.skilluv.com). En dev, localhost:5174
# est déjà accepté sans être listé ici. Le middleware `ensure_admin_origin`
# rejette 403 AUTH_ADMIN_ORIGIN_REQUIRED si l'origin n'est ni admin.*
# ni localhost:5174 ni dans cette liste.
# ADMIN_ORIGINS=https://admin.skilluv.com,https://admin-preview.skilluv.com


# ═══════════════════════════════════════════════════════════════════
# NEW — added over sessions, still to configure on Coolify.
# Fill from top to bottom ; each block explains where to fetch the value.
# ═══════════════════════════════════════════════════════════════════

# ─── SKI-34 Discord notifier (nouveau container) ────────────────
# The skilluv-discord-notifier binary polls discord_notifications_queue
# every 15s and posts to Discord via channel webhooks. Route by event
# type: rank_promotion / badge_earned  -> #promotions
#        attestation_new / slice_validated -> #annonces
#
# How to get the values :
#   1. Discord server → Settings → Integrations → Webhooks
#   2. New Webhook, name it "Skilluv Notifier", pick target channel
#   3. Copy URL (looks like https://discord.com/api/webhooks/<id>/<token>)
# Deploy this binary as a SECOND Coolify app pointing at the same repo
# with CMD overridden to ["skilluv-discord-notifier"].
DISCORD_PROMOTIONS_WEBHOOK_URL=
DISCORD_ANNONCES_WEBHOOK_URL=

# ─── SKI-32 Ops alerts (côté GitHub Actions secrets, PAS Coolify) ─
# The CI workflow posts a message here when publish/deploy or the
# scheduled health probe fails. Same procedure as above but pick the
# #ops-alerts channel (create it if missing). Paste the URL in
# GitHub → Settings → Secrets and variables → Actions as
# DISCORD_ALERT_WEBHOOK_URL. Also add SKILLUV_SMOKE_URL there
# (the smoke test script probes it every 15 min via the health cron).
# These do NOT go into the Coolify env — they live in GH Actions.

# ─── Optional: only enable when actually used ─────────────────────

# Bot Linear -> GitHub issue (SKI-72). Skip if you're not routing
# Linear tickets to GitHub issues yet.
# LINEAR_API_KEY=lin_api_...
# LINEAR_WEBHOOK_SECRET=long-random-shared-secret
# LINEAR_DONE_STATE_ID=18c7fdf3-...
# SKILLUV_BOT_GITHUB_TOKEN=ghp_...    # PAT with repo:issues:write

# Push mobile (P15). Skip if no mobile app deployed.
# FCM_SERVER_KEY=...          # Firebase Cloud Messaging (Android + web)
# APNS_KEY_ID=...             # Apple Push Notifications (iOS)

# Payments — Stripe (Phase 3, Connect + Checkout). Test-mode keys are safe.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=https://skill-uv.com/subscription/success
# STRIPE_CANCEL_URL=https://skill-uv.com/subscription/cancel
# STRIPE_PORTAL_RETURN_URL=https://skill-uv.com/account/billing

# Payments — Mobile Money (at least ONE provider needed for XOF payouts).
# PAYSTACK_SECRET_KEY=sk_test_...          # Nigeria/Ghana/South Africa
# PAYSTACK_CALLBACK_URL=https://api.skill-uv.com/api/webhooks/paystack
# FLUTTERWAVE_SECRET_KEY=FLWSECK-...        # multi-Africa
# FLUTTERWAVE_SECRET_HASH=...
# FLUTTERWAVE_REDIRECT_URL=https://skill-uv.com/checkout/return
# ORANGE_MONEY_API_KEY=...                  # Orange francophone Africa

# AI verifier (P15 llm_verifier via gRPC). Skip until skilluv-ia is deployed.
# GRPC_AI_URL=http://skilluv-ia:50051

# ═══════════════════════════════════════════════════════════════════
